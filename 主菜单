function verifyFileByMD5(filepath, expectedMD5)
    if not io.open(filepath, "r") then
        return false, ""
    end

    if file and file.md5 then

        local success, result = pcall(function()
            return file.md5(filepath, expectedMD5)
        end)

        if success then
            if result == true then
                return true, true
              else
                return false, false
            end
        end
    end
    return true
end

